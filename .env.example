# Configuracao de Chave da API do Google Gemini
# Insira sua chave obtida gratuitamente no Google AI Studio (aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
EMBEDDING_BATCH_SIZE=2
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
GENERATION_INPUT_USD_PER_MILLION=
GENERATION_OUTPUT_USD_PER_MILLION=

